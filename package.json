{
  "name": "dsh-wallpaper-custom",
  "version": "1.0.1",
  "description": "Configurable custom wallpaper plugin for the DeepSeek Harness Web UI",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "background"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/README.md",
    "assets/default.svg",
    "tools",
    "wallpaper-catalog.example.json",
    "LICENSE",
    "README.md",
    "README.en.md",
    "docs/settings-preview.webp"
  ],
  "scripts": {
    "build": "python3 tools/build-client.py",
    "test": "node tools/smoke-test.cjs",
    "prepack": "python3 tools/build-client.py"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caseclose/dsh-custom-wallpaper.git"
  },
  "homepage": "https://github.com/caseclose/dsh-custom-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/caseclose/dsh-custom-wallpaper/issues"
  }
}
